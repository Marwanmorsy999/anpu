.SH NAME
anpu-tools-install - Install an optional external tool (managed)


.SH SYNOPSIS
\fBanpu tools install [name] [flags]\fP


.SH DESCRIPTION
Install an optional external security tool from the Wave 2
registry and verify the binary resolves. Absent tools warn-and-skip
in scans until installed.

.PP
Examples:
  anpu tools install --list
  anpu tools install amass
  anpu tools install sqlmap --dry-run
  anpu tools install --all --level advanced --yes


.SH OPTIONS
\fB--all\fP[=false]
	install every installable recipe (requires --yes)

.PP
\fB--dry-run\fP[=false]
	print the recipe without installing

.PP
\fB--force\fP[=false]
	reinstall even when the binary already resolves (re-baselines the recorded digest)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for install

.PP
\fB--level\fP=""
	with --all, limit to safe, advanced, or ultra

.PP
\fB--list\fP[=false]
	list all registry recipes

.PP
\fB--yes\fP[=false]
	confirm installation without prompting


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config\fP=""
	path to a YAML config file (default: anpu.yaml in the current directory, if present)

.PP
\fB--data-dir\fP=""
	data directory for the scan-history DB and caches (default: os.UserConfigDir()/anpu; override with the ANPU_HOME environment variable)

.PP
\fB--verbose\fP[=false]
	show per-stage finding and warning counts


.SH SEE ALSO
\fBanpu-tools(1)\fP


